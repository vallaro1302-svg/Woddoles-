#!/bin/sh
set -e
cat > /etc/os-release <<'OS'
PRETTY_NAME="WODDOLES OS 0.1"
NAME="WODDOLES OS"
VERSION_ID="0.1"
VERSION="0.1 (base Debian 12)"
ID=woddoles
ID_LIKE=debian
OS
echo "WODDOLES OS" > /etc/issue
mk() { # nome exec icone arquivo
cat > "/usr/share/applications/woddoles-$4.desktop" <<D
[Desktop Entry]
Type=Application
Name=WODDOLES $1
Exec=$2
Icon=$3
Categories=Utility;
D
}
mk Explorer       thunar                  system-file-manager      explorer
mk Notepad        mousepad                accessories-text-editor  notepad
mk Calculator     galculator              accessories-calculator   calculator
mk "Task Manager" xfce4-taskmanager       utilities-system-monitor taskmanager
mk Terminal       xfce4-terminal          utilities-terminal       terminal
mk "Image Viewer" ristretto               image-viewer             imageviewer
mk "Media Player" parole                  multimedia-video-player  mediaplayer
mk Browser        firefox-esr             web-browser              browser
mk Settings       xfce4-settings-manager  preferences-system       settings
